{
  "version": 2,
  "buildCommand": "npm run build:api && npm run build:ui",
  "outputDirectory": "dist-ui",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@mysten/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
