# Copy this file to .env and fill in your values.
# .env is gitignored — never committed.

# ─────────────────────────────────────────────────────────────────
# AI  —  at least one key is required
# ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=                       # Free  → console.groq.com
# ANTHROPIC_API_KEY=                # Best quality → console.anthropic.com
# GEMINI_API_KEY=                   # Free tier  → aistudio.google.com
# OPENAI_API_KEY=                   # Fallback Whisper transcription

# ─────────────────────────────────────────────────────────────────
# Sui network
# ─────────────────────────────────────────────────────────────────
SUI_NETWORK=mainnet                  # mainnet | testnet | devnet
# SUI_PRIVATE_KEY=suiprivkey1...     # Optional — server-side on-chain execution

# 32-byte base64 secret used to AES-256-GCM encrypt Echo session keys
# before they are written to Walrus. REQUIRED for /api/echo/:wallet/session-key.
# Generate with: openssl rand -base64 32
VEKTOR_KEY_ENCRYPTION_SECRET=

# Shared secret the echo-worker presents in X-Echo-Worker-Secret to call
# POST /api/echo/:wallet/execute server-side.
# ECHO_WORKER_SECRET=

# Comma-separated CORS allowlist (defaults to http://localhost:5173)
# VEKTOR_ALLOWED_ORIGINS=http://localhost:5173,https://vektor.example

# Dedicated onboarding reserve. Testnet only. USDC transfers to new wallets only.
# Used by /api/onboard/:token/claim to fund first-touch users.
# Generate a testnet keypair and fund it with test USDC, then paste here.
# VEKTOR_FUNDING_KEY=suiprivkey1...

# ─────────────────────────────────────────────────────────────────
# App URLs  (used in payment links and invite links)
# ─────────────────────────────────────────────────────────────────
VEKTOR_URL=http://localhost:5173     # Public-facing base URL

# ─────────────────────────────────────────────────────────────────
# zkLogin — Google OAuth  (enables "Sign in with Google" flow)
#
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Authorised redirect URIs: http://localhost:5173
# 4. Copy the Client ID below
#
# The VITE_ prefix is required so Vite exposes this to the browser.
# ─────────────────────────────────────────────────────────────────
# VITE_GOOGLE_CLIENT_ID=            # e.g. 123456789-abc.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────
# Echo automation worker  (real-time rule alerts via WebSocket)
# ─────────────────────────────────────────────────────────────────
# VITE_ECHO_WORKER_URL=ws://localhost:3002

# ─────────────────────────────────────────────────────────────────
# VektorLog on-chain audit log  (optional — deploy echo-contracts first)
# After: sui client publish --gas-budget 100000000
# ─────────────────────────────────────────────────────────────────
# VEKTORLOG_PACKAGE_ID=0x...
